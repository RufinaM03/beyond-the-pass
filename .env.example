# Optional browser-check configuration only; .env is not automatically loaded.
# Set process environment variables explicitly in PowerShell if needed.
# The API's trusted release is pinned in docs/serving_release.json, not caller input.
# Start with scripts/app.ps1 -Command Serve -Port 8000 (loopback only).
BTP_BASE_URL=http://127.0.0.1:8000
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Never put credentials in this file or commit .env.
# AWS region, account, repository, certificate, and DNS are undecided.
# Use the AWS credential provider chain or GitHub OIDC in later phases.
