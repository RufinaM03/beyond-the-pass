{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Beyond the Pass public-subnet Fargate demo; choose HTTPS explicitly; approval required",
  "Parameters": {
    "ImageUri": {"Type": "String", "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.ap-south-1\\.amazonaws\\.com/btp-demo-app@sha256:[a-f0-9]{64}"},
    "RepositoryArn": {"Type": "String", "AllowedPattern": "arn:aws:ecr:ap-south-1:[0-9]{12}:repository/btp-demo-app"},
    "CodeVersion": {"Type": "String", "AllowedPattern": "[a-f0-9]{40}"},
    "HttpsMode": {"Type": "String", "AllowedValues": ["domain", "cloudfront"]},
    "CertificateArn": {"Type": "String", "Default": ""},
    "CloudFrontPrefixListId": {"Type": "String", "Default": ""},
    "OriginHeaderName": {"Type": "String", "NoEcho": true, "MinLength": 12, "MaxLength": 64, "AllowedPattern": "X-Btp-[a-f0-9]+"},
    "OriginHeaderValue": {"Type": "String", "NoEcho": true, "MinLength": 64, "MaxLength": 64, "AllowedPattern": "[a-f0-9]{64}"},
    "TaskSize": {"Type": "String", "Default": "small", "AllowedValues": ["small", "memory", "cpu"]},
    "HealthGraceSeconds": {"Type": "Number", "Default": 120, "MinValue": 60, "MaxValue": 600},
    "LogRetentionDays": {"Type": "Number", "Default": 7, "AllowedValues": [1, 3, 5, 7, 14]},
    "AvailabilityZoneA": {"Type": "AWS::EC2::AvailabilityZone::Name"},
    "AvailabilityZoneB": {"Type": "AWS::EC2::AvailabilityZone::Name"}
  },
  "Rules": {
    "DifferentZones": {"Assertions": [{"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "AvailabilityZoneA"}, {"Ref": "AvailabilityZoneB"}]}]}, "AssertDescription": "Choose two distinct available Mumbai zones"}]},
    "DomainCertificate": {"RuleCondition": {"Fn::Equals": [{"Ref": "HttpsMode"}, "domain"]}, "Assertions": [{"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "CertificateArn"}, ""]}]}, "AssertDescription": "Domain mode requires an issued Mumbai ACM certificate"}]},
    "CloudFrontOrigin": {"RuleCondition": {"Fn::Equals": [{"Ref": "HttpsMode"}, "cloudfront"]}, "Assertions": [{"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "CloudFrontPrefixListId"}, ""]}]}, "AssertDescription": "CloudFront requires the regional managed origin-facing prefix list"}]}
  },
  "Mappings": {"Sizes": {"small": {"Cpu": "256", "Memory": "512"}, "memory": {"Cpu": "256", "Memory": "1024"}, "cpu": {"Cpu": "512", "Memory": "1024"}}},
  "Conditions": {"Domain": {"Fn::Equals": [{"Ref": "HttpsMode"}, "domain"]}, "CloudFront": {"Fn::Equals": [{"Ref": "HttpsMode"}, "cloudfront"]}},
  "Resources": {
    "Vpc": {"Type": "AWS::EC2::VPC", "Properties": {"CidrBlock": "10.74.0.0/16", "EnableDnsSupport": true, "EnableDnsHostnames": true, "Tags": [{"Key": "Project", "Value": "BeyondThePass"}]}},
    "Gateway": {"Type": "AWS::EC2::InternetGateway"},
    "GatewayAttachment": {"Type": "AWS::EC2::VPCGatewayAttachment", "Properties": {"VpcId": {"Ref": "Vpc"}, "InternetGatewayId": {"Ref": "Gateway"}}},
    "SubnetA": {"Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "Vpc"}, "CidrBlock": "10.74.0.0/24", "AvailabilityZone": {"Ref": "AvailabilityZoneA"}, "MapPublicIpOnLaunch": false}},
    "SubnetB": {"Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "Vpc"}, "CidrBlock": "10.74.1.0/24", "AvailabilityZone": {"Ref": "AvailabilityZoneB"}, "MapPublicIpOnLaunch": false}},
    "Routes": {"Type": "AWS::EC2::RouteTable", "Properties": {"VpcId": {"Ref": "Vpc"}}},
    "InternetRoute": {"Type": "AWS::EC2::Route", "DependsOn": "GatewayAttachment", "Properties": {"RouteTableId": {"Ref": "Routes"}, "DestinationCidrBlock": "0.0.0.0/0", "GatewayId": {"Ref": "Gateway"}}},
    "AssociationA": {"Type": "AWS::EC2::SubnetRouteTableAssociation", "Properties": {"SubnetId": {"Ref": "SubnetA"}, "RouteTableId": {"Ref": "Routes"}}},
    "AssociationB": {"Type": "AWS::EC2::SubnetRouteTableAssociation", "Properties": {"SubnetId": {"Ref": "SubnetB"}, "RouteTableId": {"Ref": "Routes"}}},
    "AlbGroup": {"Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupDescription": "Only selected HTTPS entry or CloudFront origins", "VpcId": {"Ref": "Vpc"}, "SecurityGroupIngress": {"Fn::If": ["Domain", [{"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0"}, {"IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "CidrIp": "0.0.0.0/0"}], [{"IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "SourcePrefixListId": {"Ref": "CloudFrontPrefixListId"}}]]}, "SecurityGroupEgress": [{"IpProtocol": "tcp", "FromPort": 8000, "ToPort": 8000, "CidrIp": "10.74.0.0/16"}]}},
    "TaskGroup": {"Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupDescription": "App 8000 only from ALB; HTTPS outbound without NAT", "VpcId": {"Ref": "Vpc"}, "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 8000, "ToPort": 8000, "SourceSecurityGroupId": {"Ref": "AlbGroup"}}], "SecurityGroupEgress": [{"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0"}]}},
    "Logs": {"Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/btp/${AWS::StackName}"}, "RetentionInDays": {"Ref": "LogRetentionDays"}}},
    "ExecutionRole": {"Type": "AWS::IAM::Role", "Properties": {"RoleName": "btp-demo-execution", "PermissionsBoundary": "arn:aws:iam::044854093109:policy/BtpDemoExecutionBoundary", "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole", "Condition": {"StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}}, "ArnLike": {"aws:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"}}}}]}, "Policies": [{"PolicyName": "PullAndLogOnly", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"}, {"Effect": "Allow", "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"], "Resource": {"Ref": "RepositoryArn"}}, {"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::GetAtt": ["Logs", "Arn"]}}]}}]}},
    "ApplicationRole": {"Type": "AWS::IAM::Role", "Properties": {"RoleName": "btp-demo-application", "PermissionsBoundary": "arn:aws:iam::044854093109:policy/BtpDemoApplicationBoundary", "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole", "Condition": {"StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}}, "ArnLike": {"aws:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"}}}}]}}},
    "Cluster": {"Type": "AWS::ECS::Cluster", "Properties": {"ClusterName": "btp-demo-cluster", "ClusterSettings": [{"Name": "containerInsights", "Value": "disabled"}]}},
    "Task": {"Type": "AWS::ECS::TaskDefinition", "Properties": {
      "Family": {"Fn::Sub": "${AWS::StackName}-app"}, "RequiresCompatibilities": ["FARGATE"], "NetworkMode": "awsvpc", "RuntimePlatform": {"CpuArchitecture": "X86_64", "OperatingSystemFamily": "LINUX"},
      "Cpu": {"Fn::FindInMap": ["Sizes", {"Ref": "TaskSize"}, "Cpu"]}, "Memory": {"Fn::FindInMap": ["Sizes", {"Ref": "TaskSize"}, "Memory"]},
      "ExecutionRoleArn": {"Fn::GetAtt": ["ExecutionRole", "Arn"]}, "TaskRoleArn": {"Fn::GetAtt": ["ApplicationRole", "Arn"]}, "Volumes": [{"Name": "scratch"}],
      "ContainerDefinitions": [
        {"Name": "scratch-init", "Image": {"Ref": "ImageUri"}, "Essential": false, "User": "0:0", "ReadonlyRootFilesystem": true, "LinuxParameters": {"Capabilities": {"Drop": ["ALL"]}}, "Command": ["python", "-c", "import os; os.chmod('/scratch', 0o1777)"], "MountPoints": [{"SourceVolume": "scratch", "ContainerPath": "/scratch", "ReadOnly": false}], "LogConfiguration": {"LogDriver": "awslogs", "Options": {"awslogs-group": {"Ref": "Logs"}, "awslogs-region": {"Ref": "AWS::Region"}, "awslogs-stream-prefix": "init", "mode": "non-blocking", "max-buffer-size": "1m"}}},
        {"Name": "app", "Image": {"Ref": "ImageUri"}, "Essential": true, "User": "10001:10001", "ReadonlyRootFilesystem": true, "DependsOn": [{"ContainerName": "scratch-init", "Condition": "SUCCESS"}], "LinuxParameters": {"Capabilities": {"Drop": ["ALL"]}}, "StopTimeout": 30, "PortMappings": [{"ContainerPort": 8000, "Protocol": "tcp"}], "Environment": [{"Name": "BTP_ALLOW_FIXTURE", "Value": "0"}, {"Name": "OPENBLAS_CORETYPE", "Value": "Haswell"}], "MountPoints": [{"SourceVolume": "scratch", "ContainerPath": "/tmp/btp", "ReadOnly": false}],
          "HealthCheck": {"Command": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=4).close()"], "Interval": 30, "Timeout": 5, "Retries": 3, "StartPeriod": 120},
          "LogConfiguration": {"LogDriver": "awslogs", "Options": {"awslogs-group": {"Ref": "Logs"}, "awslogs-region": {"Ref": "AWS::Region"}, "awslogs-stream-prefix": "app", "mode": "non-blocking", "max-buffer-size": "1m"}}}
      ], "Tags": [{"Key": "CodeVersion", "Value": {"Ref": "CodeVersion"}}, {"Key": "ArtifactRelease", "Value": "btp-exploratory-v1"}]
    }},
    "Alb": {"Type": "AWS::ElasticLoadBalancingV2::LoadBalancer", "DependsOn": "GatewayAttachment", "Properties": {"Name": "btp-demo-alb", "Type": "application", "Scheme": "internet-facing", "IpAddressType": "ipv4", "Subnets": [{"Ref": "SubnetA"}, {"Ref": "SubnetB"}], "SecurityGroups": [{"Ref": "AlbGroup"}], "LoadBalancerAttributes": [{"Key": "routing.http.drop_invalid_header_fields.enabled", "Value": "true"}, {"Key": "routing.http.desync_mitigation_mode", "Value": "strictest"}, {"Key": "idle_timeout.timeout_seconds", "Value": "60"}]}},
    "Targets": {"Type": "AWS::ElasticLoadBalancingV2::TargetGroup", "Properties": {"Name": "btp-demo-targets", "VpcId": {"Ref": "Vpc"}, "TargetType": "ip", "Port": 8000, "Protocol": "HTTP", "HealthCheckPath": "/api/ready", "HealthCheckIntervalSeconds": 30, "HealthCheckTimeoutSeconds": 10, "HealthyThresholdCount": 2, "UnhealthyThresholdCount": 3, "Matcher": {"HttpCode": "200"}, "TargetGroupAttributes": [{"Key": "deregistration_delay.timeout_seconds", "Value": "30"}]}},
    "Http": {"Type": "AWS::ElasticLoadBalancingV2::Listener", "Properties": {"LoadBalancerArn": {"Ref": "Alb"}, "Port": 80, "Protocol": "HTTP", "DefaultActions": {"Fn::If": ["Domain", [{"Type": "redirect", "RedirectConfig": {"Protocol": "HTTPS", "Port": "443", "StatusCode": "HTTP_301"}}], [{"Type": "fixed-response", "FixedResponseConfig": {"StatusCode": "403", "ContentType": "text/plain", "MessageBody": "Access denied"}}]]}}},
    "Https": {"Type": "AWS::ElasticLoadBalancingV2::Listener", "Condition": "Domain", "Properties": {"LoadBalancerArn": {"Ref": "Alb"}, "Port": 443, "Protocol": "HTTPS", "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06", "Certificates": [{"CertificateArn": {"Ref": "CertificateArn"}}], "DefaultActions": [{"Type": "forward", "TargetGroupArn": {"Ref": "Targets"}}]}},
    "OriginRule": {"Type": "AWS::ElasticLoadBalancingV2::ListenerRule", "Properties": {"ListenerArn": {"Fn::If": ["Domain", {"Ref": "Https"}, {"Ref": "Http"}]}, "Priority": 1, "Conditions": [{"Field": "http-header", "HttpHeaderConfig": {"HttpHeaderName": {"Ref": "OriginHeaderName"}, "Values": [{"Ref": "OriginHeaderValue"}]}}], "Actions": [{"Type": "forward", "TargetGroupArn": {"Ref": "Targets"}}]}},
    "Service": {"Type": "AWS::ECS::Service", "DependsOn": ["InternetRoute", "AssociationA", "AssociationB", "OriginRule"], "Properties": {"ServiceName": "btp-demo-app", "Cluster": {"Ref": "Cluster"}, "TaskDefinition": {"Ref": "Task"}, "LaunchType": "FARGATE", "PlatformVersion": "1.4.0", "DesiredCount": 1, "EnableExecuteCommand": false, "HealthCheckGracePeriodSeconds": {"Ref": "HealthGraceSeconds"}, "DeploymentConfiguration": {"MinimumHealthyPercent": 100, "MaximumPercent": 200, "DeploymentCircuitBreaker": {"Enable": true, "Rollback": true}}, "NetworkConfiguration": {"AwsvpcConfiguration": {"AssignPublicIp": "ENABLED", "SecurityGroups": [{"Ref": "TaskGroup"}], "Subnets": [{"Ref": "SubnetA"}, {"Ref": "SubnetB"}]}}, "LoadBalancers": [{"ContainerName": "app", "ContainerPort": 8000, "TargetGroupArn": {"Ref": "Targets"}}]}},
"Distribution": {"Type": "AWS::CloudFront::Distribution", "Condition": "CloudFront", "DependsOn": "OriginRule", "Properties": {"Tags": [{"Key": "Project", "Value": "BeyondThePass"}], "DistributionConfig": {"Enabled": true, "HttpVersion": "http2", "IPV6Enabled": false, "PriceClass": "PriceClass_All", "ViewerCertificate": {"CloudFrontDefaultCertificate": true}, "Origins": [{"Id": "alb", "DomainName": {"Fn::GetAtt": ["Alb", "DNSName"]}, "CustomOriginConfig": {"OriginProtocolPolicy": "http-only", "HTTPPort": 80, "OriginReadTimeout": 30}, "OriginCustomHeaders": [{"HeaderName": {"Ref": "OriginHeaderName"}, "HeaderValue": {"Ref": "OriginHeaderValue"}}]}], "DefaultCacheBehavior": {"TargetOriginId": "alb", "ViewerProtocolPolicy": "redirect-to-https", "AllowedMethods": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"], "CachedMethods": ["GET", "HEAD"], "Compress": true, "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad", "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac"}, "CustomErrorResponses": [{"ErrorCode": 404, "ErrorCachingMinTTL": 0}, {"ErrorCode": 500, "ErrorCachingMinTTL": 0}, {"ErrorCode": 502, "ErrorCachingMinTTL": 0}, {"ErrorCode": 503, "ErrorCachingMinTTL": 0}, {"ErrorCode": 504, "ErrorCachingMinTTL": 0}]}}}
  },
  "Outputs": {
    "AlbDns": {"Value": {"Fn::GetAtt": ["Alb", "DNSName"]}}, "Cluster": {"Value": {"Ref": "Cluster"}}, "Service": {"Value": {"Fn::GetAtt": ["Service", "Name"]}}, "TaskDefinition": {"Value": {"Ref": "Task"}}, "TargetGroup": {"Value": {"Ref": "Targets"}}, "TaskSecurityGroup": {"Value": {"Ref": "TaskGroup"}}, "Logs": {"Value": {"Ref": "Logs"}}, "ImageUri": {"Value": {"Ref": "ImageUri"}}, "CodeVersion": {"Value": {"Ref": "CodeVersion"}}, "CloudFrontUrl": {"Condition": "CloudFront", "Value": {"Fn::Sub": "https://${Distribution.DomainName}"}}
  }
}
