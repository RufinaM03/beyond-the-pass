{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid":"EcrToken","Effect":"Allow","Action":["ecr:GetAuthorizationToken"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}},
    {"Sid":"PublishOnlyExistingRepository","Effect":"Allow","Action":["ecr:BatchCheckLayerAvailability","ecr:InitiateLayerUpload","ecr:UploadLayerPart","ecr:CompleteLayerUpload","ecr:PutImage","ecr:DescribeImages","ecr:BatchGetImage","ecr:GetDownloadUrlForLayer"],"Resource":"arn:aws:ecr:ap-south-1:044854093109:repository/btp-demo-app","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}},
    {"Sid":"ReadOnlyExactTrustedArchive","Effect":"Allow","Action":["s3:GetObject"],"Resource":"arn:aws:s3:::btp-demo-artifacts-044854093109-ap-south-1/releases/btp-exploratory-v1/f668daf9447f2f97175c7355a9388f47354b2b75/aws-release.tar.gz"},
    {"Sid":"ReadOnlyExistingStack","Effect":"Allow","Action":["cloudformation:DescribeStacks","cloudformation:DescribeStackEvents","cloudformation:ListStackResources","cloudformation:GetTemplate","cloudformation:GetTemplateSummary","cloudformation:DescribeChangeSet"],"Resource":"arn:aws:cloudformation:ap-south-1:044854093109:stack/btp-demo-app/8e6e41c0-cc4b-11f1-b4c7-02fff94de1e3","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}},
    {"Sid":"OnlyNamedApplicationChangeSets","Effect":"Allow","Action":["cloudformation:CreateChangeSet","cloudformation:ExecuteChangeSet","cloudformation:DeleteChangeSet"],"Resource":"arn:aws:cloudformation:ap-south-1:044854093109:stack/btp-demo-app/8e6e41c0-cc4b-11f1-b4c7-02fff94de1e3","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"},"StringLike":{"cloudformation:ChangeSetName":"btp-cd-*"}}},
    {"Sid":"TemplateValidation","Effect":"Allow","Action":["cloudformation:ValidateTemplate"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}},
    {"Sid":"ValidateExistingAvailabilityZoneParameters","Effect":"Allow","Action":["ec2:DescribeAvailabilityZones"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}},
    {"Sid":"ReadExistingDistributionOutputViaCloudFormation","Effect":"Allow","Action":["cloudfront:GetDistribution"],"Resource":"arn:aws:cloudfront::044854093109:distribution/E2KD3NUMXZ0BRD","Condition":{"ForAnyValue:StringEquals":{"aws:CalledVia":"cloudformation.amazonaws.com"}}},
    {"Sid":"OnlyCloudFormationApplicationTaskRevisions","Effect":"Allow","Action":["ecs:RegisterTaskDefinition","ecs:TagResource","ecs:UntagResource"],"Resource":"arn:aws:ecs:ap-south-1:044854093109:task-definition/btp-demo-app-app:*","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"},"ForAnyValue:StringEquals":{"aws:CalledVia":"cloudformation.amazonaws.com"}}},
    {"Sid":"OnlyCloudFormationExistingServiceUpdate","Effect":"Allow","Action":["ecs:UpdateService","ecs:TagResource","ecs:UntagResource"],"Resource":"arn:aws:ecs:ap-south-1:044854093109:service/btp-demo-cluster/btp-demo-app","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"},"ForAnyValue:StringEquals":{"aws:CalledVia":"cloudformation.amazonaws.com"}}},
    {"Sid":"CloudFormationTaskDeregistrationRequiresWildcard","Effect":"Allow","Action":["ecs:DeregisterTaskDefinition"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"},"ForAnyValue:StringEquals":{"aws:CalledVia":"cloudformation.amazonaws.com"}}},
    {"Sid":"ReadExistingClusterAndService","Effect":"Allow","Action":["ecs:DescribeClusters","ecs:DescribeServices"],"Resource":["arn:aws:ecs:ap-south-1:044854093109:cluster/btp-demo-cluster","arn:aws:ecs:ap-south-1:044854093109:service/btp-demo-cluster/btp-demo-app"],"Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}},
    {"Sid":"ReadProjectTasks","Effect":"Allow","Action":["ecs:DescribeTasks"],"Resource":"arn:aws:ecs:ap-south-1:044854093109:task/btp-demo-cluster/*","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}},
    {"Sid":"ListOnlyProjectClusterTasks","Effect":"Allow","Action":["ecs:ListTasks"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1","ecs:cluster":"arn:aws:ecs:ap-south-1:044854093109:cluster/btp-demo-cluster"}}},
    {"Sid":"NecessaryUnscopableReads","Effect":"Allow","Action":["ecs:DescribeTaskDefinition","elasticloadbalancing:DescribeTargetHealth"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}},
    {"Sid":"PassOnlyExistingTaskRolesViaCloudFormation","Effect":"Allow","Action":["iam:PassRole"],"Resource":["arn:aws:iam::044854093109:role/btp-demo-execution","arn:aws:iam::044854093109:role/btp-demo-application"],"Condition":{"StringEquals":{"iam:PassedToService":"ecs-tasks.amazonaws.com"},"ForAnyValue:StringEquals":{"aws:CalledVia":"cloudformation.amazonaws.com"}}},
    {"Sid":"ReadOnlyExistingTaskRoleConfiguration","Effect":"Allow","Action":["iam:GetRole","iam:GetRolePolicy"],"Resource":["arn:aws:iam::044854093109:role/btp-demo-execution","arn:aws:iam::044854093109:role/btp-demo-application"]},
    {"Sid":"ReadProjectEcsTags","Effect":"Allow","Action":["ecs:ListTagsForResource"],"Resource":["arn:aws:ecs:ap-south-1:044854093109:task-definition/btp-demo-app-app:*","arn:aws:ecs:ap-south-1:044854093109:service/btp-demo-cluster/btp-demo-app"],"Condition":{"StringEquals":{"aws:RequestedRegion":"ap-south-1"}}}
  ]
}
