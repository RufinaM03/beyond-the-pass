{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateExecutionRoleOnlyWithFixedBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "arn:aws:iam::044854093109:role/btp-demo-execution",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::044854093109:policy/BtpDemoExecutionBoundary"
        }
      }
    },
    {
      "Sid": "CreateApplicationRoleOnlyWithFixedBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "arn:aws:iam::044854093109:role/btp-demo-application",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::044854093109:policy/BtpDemoApplicationBoundary"
        }
      }
    },
    {
      "Sid": "OnlyTwoRoleLifecycleViaCloudFormation",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::044854093109:role/btp-demo-execution",
        "arn:aws:iam::044854093109:role/btp-demo-application"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "OnlyExecutionInlinePolicyViaCloudFormation",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::044854093109:role/btp-demo-execution",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyTwoRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": [
        "arn:aws:iam::044854093109:role/btp-demo-execution",
        "arn:aws:iam::044854093109:role/btp-demo-application"
      ]
    },
    {
      "Sid": "ReadOnlyBoundaryDefinitions",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::044854093109:policy/BtpDemoExecutionBoundary",
        "arn:aws:iam::044854093109:policy/BtpDemoApplicationBoundary"
      ]
    },
    {
      "Sid": "PassOnlyTwoBoundedRolesToEcs",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::044854093109:role/btp-demo-execution",
        "arn:aws:iam::044854093109:role/btp-demo-application"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateOnlyRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": [
        "arn:aws:iam::044854093109:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
        "arn:aws:iam::044854093109:role/aws-service-role/elasticloadbalancing.amazonaws.com/AWSServiceRoleForElasticLoadBalancing"
      ],
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "NeverRemoveOrReplaceBoundaries",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::044854093109:role/btp-demo-execution",
        "arn:aws:iam::044854093109:role/btp-demo-application"
      ]
    }
  ]
}
